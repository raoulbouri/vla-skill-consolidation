# Copy to .env and adjust. Paths and settings only: never put credentials or tokens in this file.
# Every script sources env.sh, which loads .env (falling back to this file).
# Replace /path/to/... with directories on your machine; the comments give the sizes to expect.

# Large assets live outside the repository.
OPENPI_DATA_HOME=/path/to/cache/openpi                    # OpenPI download cache (pi05_libero checkpoint, ~12 GB)
LIBERO_DATA_ROOT=/path/to/data/libero                     # official LIBERO HDF5 demos (contains libero_90/)
CLVLA_OUTPUT_ROOT=/path/to/vla-skill-consolidation/outputs  # run artifacts (git-ignored); extract the Drive packages here
CLVLA_PROCESSED_ROOT=/path/to/project-data/processed      # versioned aligned demos (immutable, ~9 GB)
HF_LEROBOT_HOME=/path/to/project-data/lerobot             # LeRobot datasets read by OpenPI's loader (~7 GB)

# Tool caches (keep them off a small root disk).
UV_CACHE_DIR=/path/to/cache/uv
UV_PYTHON_INSTALL_DIR=/path/to/cache/uv-python
HF_HOME=/path/to/cache/hf

# GPU: the policy server and EGL rendering use only this physical GPU. On shared machines run scripts/gpu_guard.sh first.
CLVLA_GPU=0
CLVLA_SERVER_PORT=8000
# Bit-reproducible policy inference across server processes (default XLA autotuning picks different GPU kernels per
# process, and closed-loop rollouts amplify the ~1e-4 differences into different episode outcomes).
CLVLA_XLA_FLAGS="--xla_gpu_deterministic_ops=true --xla_gpu_autotune_level=0"
