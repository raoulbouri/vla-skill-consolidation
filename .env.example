# Copy to .env and adjust. Paths and settings only: never put credentials or tokens in this file.
# Every script sources env.sh, which loads .env (falling back to this file).

# Large assets live outside the repository.
OPENPI_DATA_HOME=/mnt/data/users/bbouri/cache/openpi        # OpenPI download cache (pi05_libero checkpoint, ~12 GB)
LIBERO_DATA_ROOT=/mnt/data/users/bbouri/cl/data/libero      # official LIBERO HDF5 demos (contains libero_90/)
CLVLA_OUTPUT_ROOT=/mnt/data/users/bbouri/IRL-project/outputs # run artifacts (git-ignored)

# Tool caches (kept off the nearly-full root disk).
UV_CACHE_DIR=/mnt/data/users/bbouri/cache/uv
UV_PYTHON_INSTALL_DIR=/mnt/data/users/bbouri/cache/uv-python
HF_HOME=/mnt/data/users/bbouri/cache/hf

# GPU: xulab GPUs are shared. Only this physical GPU is ever used (policy server + EGL rendering).
CLVLA_GPU=1
CLVLA_SERVER_PORT=8000
